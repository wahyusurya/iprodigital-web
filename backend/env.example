# ---- Required ----
MONGO_URI=mongodb://mongo:27017/iprodigital
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# ---- Optional ----
PORT=4000
PUBLIC_URL=http://localhost:8093
APP_NAME=Ipro Digital
UPLOAD_DIR=uploads

# ---- Optional: S3-compatible object storage (MinIO/R2/AWS) ----
# If S3_ENDPOINT, S3_BUCKET, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY, and S3_PUBLIC_URL
# are set, uploads go to the bucket. Otherwise uploads stay on local disk.
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_BUCKET=iprodigital-public
# S3_PRIVATE_BUCKET=iprodigital-private
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_REGION=auto
# S3_PUBLIC_URL=https://cdn.example.com/iprodigital-public

# ---- Optional: SMTP email ----
# MAIL_FROM=no-reply@example.com
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=...
# SMTP_PASS=...
