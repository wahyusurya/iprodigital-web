# Required — server refuses to boot without it. Generate: openssl rand -hex 32
JWT_SECRET=

# Admin seed (created on first boot if missing)
ADMIN_EMAIL=admin@iprodigital.id
ADMIN_PASSWORD=change-me
ADMIN_NAME=Admin

APP_NAME=Ipro Digital
PUBLIC_URL=http://localhost:8093
JWT_EXPIRY=12h
UPLOAD_DIR=uploads

# Email chain (first configured wins: Mailgun -> Brevo -> SMTP -> log-only).
# OTP and reset links only reach inboxes when one of these is set.
MAIL_FROM=no-reply@iprodigital.id
# MAILGUN_API_KEY=
# MAILGUN_DOMAIN=
# BREVO_API_KEY=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

# S3-compatible object storage (R2/MinIO/AWS). Uploads go to the bucket only when
# ALL of these are set; otherwise falls back to local disk (UPLOAD_DIR).
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=iprodigital-public
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto
S3_PUBLIC_URL=https://<public-url-bucket>

# Mongo. Leave unset to use the bundled container (`docker compose --profile local-db up -d`).
# Existing mongo on the host: mongodb://host.docker.internal:27017/iprodigital
# MONGO_URI=
