{
  "name": "SaaSProduct",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nama Produk"
    },
    "tagline": {
      "type": "string",
      "title": "Tagline"
    },
    "description": {
      "type": "string",
      "title": "Deskripsi"
    },
    "image_url": {
      "type": "string",
      "title": "URL Gambar",
      "format": "uri"
    },
    "features": {
      "type": "string",
      "title": "Fitur (pisahkan dengan koma)"
    },
    "cta_label": {
      "type": "string",
      "title": "Label Tombol",
      "default": "Pelajari Lebih Lanjut"
    },
    "cta_link": {
      "type": "string",
      "title": "Link Tombol",
      "format": "uri"
    },
    "badge": {
      "type": "string",
      "title": "Badge",
      "description": "Contoh: Early Bird, Demo Tersedia"
    },
    "status": {
      "type": "string",
      "title": "Status",
      "enum": [
        "active",
        "coming_soon"
      ],
      "default": "active"
    },
    "accent_color": {
      "type": "string",
      "title": "Warna Aksen (hex)",
      "default": "#1a3a6b"
    },
    "sort_order": {
      "type": "number",
      "title": "Urutan Tampil",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}