{
  "name": "TeamMember",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nama Lengkap"
    },
    "role": {
      "type": "string",
      "title": "Jabatan / Peran"
    },
    "department": {
      "type": "string",
      "title": "Divisi",
      "enum": [
        "Leadership",
        "Pajak & Pembukuan",
        "Digital Marketing",
        "Software & AI",
        "Operasional"
      ]
    },
    "bio": {
      "type": "string",
      "title": "Biografi Singkat (kartu)"
    },
    "description": {
      "type": "string",
      "title": "Deskripsi Lengkap (detail modal)"
    },
    "image_url": {
      "type": "string",
      "title": "URL Foto",
      "format": "uri"
    },
    "linkedin_url": {
      "type": "string",
      "title": "URL LinkedIn",
      "format": "uri"
    },
    "instagram_url": {
      "type": "string",
      "title": "URL Instagram",
      "format": "uri"
    },
    "facebook_url": {
      "type": "string",
      "title": "URL Facebook",
      "format": "uri"
    },
    "whatsapp_number": {
      "type": "string",
      "title": "Nomor WhatsApp"
    },
    "email": {
      "type": "string",
      "title": "Email"
    },
    "sort_order": {
      "type": "number",
      "title": "Urutan Tampil",
      "default": 0
    }
  },
  "required": [
    "name"
  ]
}