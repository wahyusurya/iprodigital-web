{
  "name": "Event",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Judul Acara"
    },
    "slug": {
      "type": "string",
      "title": "Slug URL"
    },
    "excerpt": {
      "type": "string",
      "title": "Ringkasan"
    },
    "description": {
      "type": "string",
      "title": "Deskripsi Lengkap"
    },
    "date": {
      "type": "string",
      "title": "Tanggal",
      "format": "date"
    },
    "start_time": {
      "type": "string",
      "title": "Jam Mulai (contoh: 19:00)"
    },
    "end_time": {
      "type": "string",
      "title": "Jam Selesai (contoh: 21:00)"
    },
    "event_type": {
      "type": "string",
      "title": "Tipe Acara",
      "enum": [
        "Webinar",
        "Workshop",
        "Seminar",
        "Bootcamp"
      ],
      "default": "Webinar"
    },
    "location": {
      "type": "string",
      "title": "Lokasi / Platform"
    },
    "is_online": {
      "type": "boolean",
      "title": "Acara Online",
      "default": true
    },
    "image_url": {
      "type": "string",
      "title": "URL Gambar",
      "format": "uri"
    },
    "registration_link": {
      "type": "string",
      "title": "Link Pendaftaran",
      "format": "uri"
    },
    "price": {
      "type": "string",
      "title": "Harga (contoh: Gratis atau Rp 150.000)",
      "default": "Gratis"
    },
    "capacity": {
      "type": "number",
      "title": "Kapasitas Peserta"
    },
    "is_published": {
      "type": "boolean",
      "title": "Publikasikan",
      "default": true
    },
    "sort_order": {
      "type": "number",
      "title": "Urutan Tampil",
      "default": 0
    }
  },
  "required": [
    "title"
  ]
}