      "title": "URL Instagram"
    },
    "tiktok_url": {
      "type": "string",
      "title": "URL TikTok"
    },
    "youtube_url": {
      "type": "string",
      "title": "URL YouTube"
    },
    "gmaps_url": {
      "type": "string",
      "title": "URL Google Maps"
    },
    "facebook_url": {
