{
  "name": "Portfolio",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "title": "Judul Proyek"
    },
    "description": {
      "type": "string",
      "title": "Deskripsi"
    },
    "category": {
      "type": "string",
      "title": "Kategori",
      "enum": [
        "Website",
        "SEO",
        "Pajak & Pembukuan",
        "Aplikasi Mobile",
        "AI & Otomatisasi",
        "Digital Marketing"
      ]
    },
    "image_url": {
      "type": "string",
      "title": "URL Gambar",
      "format": "uri"
    },
    "client_name": {
      "type": "string",
      "title": "Nama Klien"
    },
    "client_logo_url": {
      "type": "string",
      "title": "URL Logo Klien",
      "format": "uri"
    },
    "project_url": {
      "type": "string",
      "title": "URL Proyek",
      "format": "uri"
    },
    "outcome": {
      "type": "string",
      "title": "Hasil / Capaian"
    },
    "sort_order": {
      "type": "number",
      "title": "Urutan Tampil",
      "default": 0
    }
  },
  "required": [
    "title"
  ]
}